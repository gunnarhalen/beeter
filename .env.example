# Beeter - Variáveis de Ambiente

# Configurações de Pagamento (Stripe)
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=sk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Configurações de Pagamento (PagSeguro)
# Obtenha suas credenciais em: https://pagseguro.uol.com.br
PAGSEGURO_EMAIL=seu-email@exemplo.com
PAGSEGURO_TOKEN=seu-token-de-autenticacao-aqui

# URLs de Retorno (Webhooks)
# Configure estas URLs no painel do Stripe/PagSeguro
STRIPE_WEBHOOK_SECRET=whsec_seu_secret_de_webhook_aqui
PAGSEGURO_WEBHOOK_URL=https://seu-dominio.com/webhook/pagseguro

# Configurações Adicionais (opcional)
# ENVIRONMENT=development|production
# PAYMENT_CURRENCY=BRL
# DEFAULT_BASIC_PLAN_PRICE=9.90
# DEFAULT_PREMIUM_PLAN_PRICE=19.90
